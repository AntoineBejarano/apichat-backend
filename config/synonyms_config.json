{
  "version": "1.0.0",
  "description": "Configuración principal para el sistema de sinónimos del Fast Schema Path",
  "last_updated": "2025-08-20",
  "config_files": {
    "general_synonyms": "synonyms.json",
    "translations": "translations.json",
    "domain_synonyms": "domain_synonyms.json"
  },
  "settings": {
    "auto_reload": true,
    "cache_ttl_seconds": 300,
