  "domains": [
    "ecommerce",
    "crm", 
    "hr",
    "finance",
    "inventory"
  ],
  "supported_languages": [
    "es",
    "en"
  ],
  "metadata": {
    "total_synonyms": 0,
    "total_translations": 0,
    "total_domains": 5
  }
}
